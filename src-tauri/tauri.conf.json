{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traywise",
  "version": "0.2.0",
  "identifier": "com.traywise.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../src/assets/fonts/Doto-OFL.txt": "licenses/Doto-OFL.txt",
      "../src/assets/fonts/OCR-A-LICENSE.txt": "licenses/OCR-A-LICENSE.txt"
    },
    "publisher": "Traywise",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCMTk0REQyRTE4MTc2RUMKUldUc2RvSGgwazBaeTVNTXFZblFscHYrS3pFU3lEZjNlWXJHMlNVNlFrYUEwd3ViU2YrWWwvY04K",
      "endpoints": ["https://github.com/SA-Kathir/traywise/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
